{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BankkRoll/scopedeck/blob/main/docs/finding-schema.json",
  "title": "Scopedeck finding",
  "description": "A finding that Scopedeck can import into a report draft.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "asset": {
      "type": "string",
      "minLength": 1
    },
    "weakness": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "object",
          "properties": {
            "cwe": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "severity": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        {
          "type": "object",
          "properties": {
            "rating": {
              "type": "string",
              "enum": [
                "none",
                "low",
                "medium",
                "high",
                "critical"
              ]
            },
            "cvss": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "rating"
          ]
        }
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "steps": {
      "anyOf": [
        {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "impact": {
      "type": "string",
      "minLength": 1
    },
    "poc": {
      "type": "string",
      "minLength": 1
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "steps",
    "impact"
  ]
}
