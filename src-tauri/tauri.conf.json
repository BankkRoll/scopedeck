{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Scopedeck",
  "version": "0.1.3",
  "identifier": "dev.scopedeck.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Scopedeck",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": false,
        "backgroundColor": "#0d0e10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: https://profile-photos.hackerone-user-content.com",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Desktop client for the HackerOne Hacker API",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "homepage": "https://github.com/BankkRoll/scopedeck",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "windows/installer.nsi",
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "windows/installer-header.bmp",
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MEE2RTk1NjVFRDBGNzUKUldSMUQrMWxsVzRLMlZPNzJOSTJubnZ2VFVlbERmZEJ2MHRnbXhVSUJBSVhPQTV0ZDI4MG5MaEYK",
      "endpoints": ["https://github.com/BankkRoll/scopedeck/releases/latest/download/latest.json"]
    }
  }
}
