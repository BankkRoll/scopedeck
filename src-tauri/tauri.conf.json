{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Scopedeck",
  "version": "0.1.0",
  "identifier": "dev.scopedeck.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Scopedeck",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": false,
        "backgroundColor": "#0d0e10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "worker-src": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Desktop client for the HackerOne Hacker API",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5MEE2RTk1NjVFRDBGNzUKUldSMUQrMWxsVzRLMlZPNzJOSTJubnZ2VFVlbERmZEJ2MHRnbXhVSUJBSVhPQTV0ZDI4MG5MaEYK",
      "endpoints": ["https://github.com/scopedeck/scopedeck/releases/latest/download/latest.json"]
    }
  }
}
